.container {
  padding: 0 0 60rpx;
}

.header {
  text-align: center;
  padding: 80rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.subtitle {
  color: #8892b0;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.cards {
  padding: 0 32rpx;
}

.card-item {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.3);
  transition: transform 0.2s;
}

.card-item:active {
  transform: scale(0.98);
}

.card-icon {
  font-size: 56rpx;
  margin-right: 28rpx;
  width: 80rpx;
  text-align: center;
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #e6f1ff;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #8892b0;
}

.card-arrow {
  font-size: 48rpx;
  color: #303C55;
  margin-left: 16rpx;
}

.footer-tip {
  text-align: center;
  padding: 48rpx 40rpx;
}

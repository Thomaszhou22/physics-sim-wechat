.container {
  padding: 32rpx;
  min-height: 100vh;
}

.upload-area {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 60rpx;
}

.upload-btn {
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  border: 2rpx dashed #303C55;
}

.upload-btn:active {
  border-color: #64ffda;
  background: rgba(100,255,218,0.05);
}

.upload-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 32rpx;
  color: #8892b0;
}

.preview-section {
  margin-bottom: 32rpx;
}

.preview-img {
  width: 100%;
  border-radius: 16rpx;
  border: 2rpx solid #303C55;
}

.re-choose {
  text-align: center;
  color: #64ffda;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.ocr-section {
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 32rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  color: #8892b0;
  margin-bottom: 16rpx;
}

.ocr-input {
  width: 100%;
  min-height: 200rpx;
  background: #0f3460;
  border: 2rpx solid #303C55;
  border-radius: 12rpx;
  padding: 24rpx;
  color: #e6f1ff;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.subject-switch {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.subject-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #0f3460;
  color: #8892b0;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.subject-btn.active {
  background: rgba(100,255,218,0.1);
  color: #64ffda;
  border-color: #64ffda;
}

.btn-primary {
  width: 100%;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(22,33,62,0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  text-align: center;
}

.loading-text {
  display: block;
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #64ffda;
}

.loading-dots {
  justify-content: center;
}

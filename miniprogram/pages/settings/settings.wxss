.container {
  padding: 32rpx;
  min-height: 100vh;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  color: #8892b0;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.section-hint {
  display: block;
  font-size: 22rpx;
  color: #4a5568;
  margin-top: 8rpx;
}

.input-base {
  width: 100%;
  background: #1a1a2e;
  border: 2rpx solid #303C55;
  border-radius: 12rpx;
  padding: 24rpx;
  color: #e6f1ff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.placeholder {
  color: #4a5568;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #1a1a2e;
  border: 2rpx solid #303C55;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #e6f1ff;
}

.picker-arrow {
  color: #8892b0;
}

.save-btn {
  width: 100%;
  margin-top: 20rpx;
}

.tips {
  margin-top: 48rpx;
  padding: 28rpx;
  background: rgba(100,255,218,0.05);
  border-radius: 16rpx;
  border-left: 6rpx solid #64ffda;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  color: #64ffda;
  margin-bottom: 12rpx;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  color: #8892b0;
  line-height: 1.8;
}

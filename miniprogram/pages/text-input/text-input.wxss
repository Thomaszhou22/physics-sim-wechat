.container {
  padding: 32rpx;
  min-height: 100vh;
}

.subject-switch {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.subject-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #1a1a2e;
  color: #8892b0;
  font-size: 30rpx;
  border: 2rpx solid transparent;
}

.subject-btn.active {
  background: rgba(100,255,218,0.1);
  color: #64ffda;
  border-color: #64ffda;
}

.input-section {
  position: relative;
  margin-bottom: 32rpx;
}

.prompt-input {
  width: 100%;
  min-height: 240rpx;
  background: #1a1a2e;
  border: 2rpx solid #303C55;
  border-radius: 16rpx;
  padding: 28rpx;
  color: #e6f1ff;
  font-size: 30rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.placeholder {
  color: #4a5568;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  font-size: 22rpx;
  color: #4a5568;
}

.tags-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  color: #8892b0;
  margin-bottom: 16rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
}

.btn-wrap {
  margin-top: 20rpx;
}

.btn-wrap .btn-primary {
  width: 100%;
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(22,33,62,0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  text-align: center;
  padding: 60rpx;
}

.loading-text {
  display: block;
  margin-top: 32rpx;
  font-size: 32rpx;
  color: #64ffda;
  margin-bottom: 16rpx;
}

.loading-dots {
  justify-content: center;
}

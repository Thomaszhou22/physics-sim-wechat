/* 全局样式 - 深色主题 */
page {
  background-color: #16213e;
  color: #e6f1ff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.3);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #64ffda, #4facfe);
  color: #1a1a2e;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-secondary {
  background: transparent;
  color: #64ffda;
  border: 2rpx solid #64ffda;
  border-radius: 16rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  text-align: center;
}

/* 输入框 */
.input-base {
  background: #0f3460;
  border: 2rpx solid #303C55;
  border-radius: 12rpx;
  padding: 24rpx;
  color: #e6f1ff;
  font-size: 28rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin: 8rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #0f3460;
  color: #8892b0;
  border: 2rpx solid transparent;
}

.tag.active {
  background: rgba(100,255,218,0.15);
  color: #64ffda;
  border-color: #64ffda;
}

/* 标题 */
.title-large {
  font-size: 48rpx;
  font-weight: 700;
  color: #e6f1ff;
}

.title-medium {
  font-size: 36rpx;
  font-weight: 600;
  color: #e6f1ff;
}

/* 文本辅助 */
.text-secondary {
  color: #8892b0;
  font-size: 24rpx;
}

.text-accent {
  color: #64ffda;
}

/* Flex 布局 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-row {
  display: flex;
  flex-direction: row;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  gap: 8rpx;
}

.loading-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #64ffda;
  animation: bounce 1.4s infinite ease-in-out both;
}

.loading-dots .dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dots .dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}
